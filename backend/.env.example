# Copy to backend/.env and fill in. Never commit .env.

# --- The brain's AI model ---------------------------------------------------
# Option A (default when ELEVENLABS_API_KEY is set): through an ElevenLabs agent,
# paid from ElevenLabs credits. Run `make agent` once to create the agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Model inside the agent (ElevenLabs LLM id), e.g. claude-sonnet-5-5, claude-opus-5-5
ELEVENLABS_LLM=claude-sonnet-5-5
# none | minimal | low | medium | high: higher thinks longer but may hit ElevenLabs' 15 s start limit
ELEVENLABS_REASONING_EFFORT=medium
# Voice for "read it aloud" (empty = first voice on the account) and TTS model
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Option B: the Anthropic API directly
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# elevenlabs | anthropic (empty = elevenlabs if its key is set)
BRAIN_PROVIDER=
# low | medium | high: more effort = more careful answers, slower and pricier
CLAUDE_EFFORT=medium

# MongoDB Atlas connection string (or mongodb://localhost:27017 for a local instance)
MONGODB_URI=
MONGODB_DB=security_assistant

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Demo staff login for the support console (/agent). Pick your own password.
AGENT_DEMO_USER=demo.agent
AGENT_DEMO_PASSWORD=
