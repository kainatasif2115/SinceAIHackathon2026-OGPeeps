# Copy to backend/.env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# MongoDB Atlas connection string (or mongodb://localhost:27017 for a local instance)
MONGODB_URI=
MONGODB_DB=security_assistant

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
