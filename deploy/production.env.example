# Copy to backend/.env.production and fill in. That file is git-ignored; deploy/gcp.sh
# stores the values in Google Secret Manager.

# Same ElevenLabs account as the agent (run `make agent` with this key first).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Allow access from
# anywhere (0.0.0.0/0) in Atlas > Network Access, because Cloud Run has no fixed address.
MONGODB_URI=
MONGODB_DB=ogpeeps

# Optional: login for the demo staff console (/agent). Leave the password empty to
# switch the console login off. The username defaults to demo.agent.
AGENT_DEMO_USER=demo.agent
AGENT_DEMO_PASSWORD=

# Optional: leave empty and the script generates one the first time.
DJANGO_SECRET_KEY=
