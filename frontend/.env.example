# Copy to .env.local. Where the Django backend runs (used by the /api proxy).
BACKEND_URL=http://127.0.0.1:8000

# Mock mode: set to 1 to answer every /api call in the browser with canned
# responses from src/lib/mock-api.ts. The backend is not needed or contacted.
# Useful for UI work and as a demo fallback. Restart `next dev` after changing.
# In the mock, examples cover an eSIM takeover (question -> permission ->
# critical answer with "Talk to a person"), a harmless bill notice, and a
# CEO-fraud email. Put "#error" in the first message to see the error state.
NEXT_PUBLIC_MOCK_API=0
